# 複製為 .env 並填入實際值（.env 不進版控）
# 資料庫連線（asyncpg 驅動）；database 名為 creafly
DATABASE_URL='postgresql+asyncpg://USER:PASSWORD@HOST:5432/creafly'
# MCP / Cursor 用（同步 psycopg 格式，去掉 +asyncpg；與 DATABASE_URL 同 host/user/password）
# .cursor/run-creafly-postgres-mcp.sh 會讀此變數；或可直接設定下方 DB_* 變數
POSTGRES_CONNECTION_STRING='postgresql://USER:PASSWORD@HOST:5432/creafly'
# mcp-postgres 套件用（可選；未設定時由 POSTGRES_CONNECTION_STRING 自動解析）
# DB_HOST=HOST
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=PASSWORD
# DB_NAME=creafly
# 老師後台（正式環境請維持 TEACHER_AUTH_DISABLED 未設定或 =0）
# TEACHER_AUTH_DISABLED=1
# 老師自行註冊邀請碼（未設定 = 開放註冊）
# TEACHER_REGISTER_CODE=your-secret-code
# PUBLIC_TEACHER_URL=https://droneclassroom.pages.dev/teacher/
# 關卡授權：open（預設全開）| demo_only | enforce
# ENTITLEMENT_MODE=open
# DEMO_LEVEL_IDS=1-0,1-1,1-2
